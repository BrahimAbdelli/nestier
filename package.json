{
  "name": "nestier",
  "version": "2.0.3",
  "description": "A production-ready NestJS boilerplate with Hexagonal Architecture, Generic Repository Pattern, and comprehensive testing",
  "author": "Brahim Abdelli",
  "private": false,
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:report": "eslint \"{src,apps,libs,test}/**/*.ts\" --format json --output-file eslint-report.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config=./jest-e2e.config.js --runInBand  --colors --detectOpenHandles --forceExit --coverage=true --no-cache",
    "sonar": "sonar-scanner -Dsonar.host.url=http://localhost:9000",
    "sonar:start": "docker-compose up -d sonarqube",
    "sonar:stop": "docker-compose stop sonarqube",
    "sonar:logs": "docker-compose logs -f sonarqube",
    "sonar:auto": "node scripts/sonar-setup.js",
    "sonar:analyze": "npm run test:cov && npm run sonar",
    "sonar:clean": "rimraf coverage .scannerwork dist"
  },
  "dependencies": {
    "@automapper/classes": "^8.8.1",
    "@automapper/core": "^8.8.1",
    "@automapper/nestjs": "^8.8.1",
    "@faker-js/faker": "^10.4.0",
    "@nestjs-modules/mailer": "^2.3.4",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.1",
    "@nestjs/typeorm": "^11.0.1",
    "@types/async-retry": "^1.4.9",
    "async-retry": "^1.3.3",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.4.1",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "jest-util": "^30.3.0",
    "jsonwebtoken": "^9.0.3",
    "logform": "^2.7.0",
    "mongodb": "^7.5.0",
    "node-mailjet": "^6.0.11",
    "nodemailer": "^8.0.6",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "serve-favicon": "^2.5.1",
    "sonarqube-scanner": "^4.3.6",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.31",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^6.0.0",
    "@types/estree": "^1.0.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-async-foreach": "^0.1.1",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.3.0",
    "prettier": "^3.9.6",
    "puppeteer": "^24.43.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
