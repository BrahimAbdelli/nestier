{
  "name": "nestier",
  "version": "2.0.0",
  "description": "A Nestjs boilerplate",
  "author": "Brahim Abdelli",
  "private": false,
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:report": "eslint \"{src,apps,libs,test}/**/*.ts\" --format json --output-file eslint-report.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config=./jest-e2e.config.js --runInBand  --colors --detectOpenHandles --forceExit --coverage=true --no-cache",
    "sonar": "sonar-scanner -Dsonar.host.url=http://localhost:9000",
    "sonar:start": "docker-compose up -d sonarqube",
    "sonar:stop": "docker-compose stop sonarqube",
    "sonar:logs": "docker-compose logs -f sonarqube",
    "sonar:auto": "node scripts/sonar-setup.js",
    "sonar:analyze": "npm run test:cov && npm run sonar",
    "sonar:clean": "rimraf coverage .scannerwork dist"
  },
  "dependencies": {
    "@automapper/classes": "^8.8.1",
    "@automapper/core": "^8.8.1",
    "@automapper/nestjs": "^8.8.1",
    "@faker-js/faker": "^10.0.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "10.3.8",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "10.3.8",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/typeorm": "^11.0.0",
    "@types/async-retry": "^1.4.9",
    "async-retry": "^1.3.3",
    "axios": "^1.8.4",
    "cache-manager": "~6.4.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.0",
    "dotenv": "^16.4.7",
    "express-rate-limit": "^7.5.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "logform": "^2.7.0",
    "mongodb": "^6.15.0",
    "node-mailjet": "^6.0.8",
    "nodemailer": "^6.10.0",
    "reflect-metadata": "0.1.14",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "serve-favicon": "^2.5.0",
    "sonarqube-scanner": "^4.3.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.21",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^10.3.8",
    "@types/estree": "^1.0.7",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.14",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-no-async-foreach": "^0.1.1",
    "eslint-plugin-prettier": "^5.2.5",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "puppeteer": "^24.26.1",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  }
}
