# Server Configuration
SERVER_PORT=3000
SERVER_HOST=localhost

# Database Configuration (MongoDB)
MONGO_URL=mongodb://localhost:27017/test_shop?serverSelectionTimeoutMS=2000

# JWT Authentication
SECRET=test-secret-key-for-testing-only
TOKEN_EXPIRATION=1h
RESET_PASSWORD_EXPIRATION="24h"
RESET_PASSWORD_URL=http://localhost:3000/reset-password
SUPPORT_EMAIL=test@example.com

# Mailjet Email
MAILJET_EMAIL=test@example.com
MAILJET_API_KEY=test-mailjet-api-key
MAILJET_SECRET_KEY=test-mailjet-secret-key
MAILJET_VERSION=v3.1
MAILJET_COMPANY_NAME=Test Company

# Product Configuration
RESTRICTED_WORDS=replica,knockoff,counterfeit,imitation

# Application Environment
NODE_ENV=test
